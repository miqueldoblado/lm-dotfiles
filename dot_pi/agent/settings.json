    "npm:pi-clarify",
    "npm:pi-powerline-footer",
    "npm:pi-rewind",
    "npm:pi-web-access@0.35.0",
    "git:git@github.com:Launchmetrics/LM-AI@main",
    "npm:@tintinweb/pi-subagents@0.22.1"
  ],
  "powerline": {
    "welcome": false,
    "cost": {
      "subscriptionDisplay": "reported-cost"
    },
    "fixedEditor": false,
    "layout": {
      "left": [
        "model",
        "thinking",
        "shell_mode",
        "path",
        "context_pct",
        "cost"
      ],
      "secondary": [
        "git"
      ]
    }
  },
