{
  "lastChangelogVersion": "1.4.0",
  "theme": "dark",
  "defaultProvider": "openrouter",
  "defaultModel": "deepseek/deepseek-v4.1-flash-1017",
  "defaultProjectTrust": "always",
  "defaultThinkingLevel": "max",
  "hideThinkingBlock": true,
  "quietStartup": true,
  "customHeader": {
    "skillsMode": true
  },
  "packages": [
    "npm:@dietrichgebert/ponytail",
    "npm:@plannotator/pi-extension",
    "npm:@ff-labs/pi-fff",
    "npm:@juicesharp/rpiv-todo",
    "npm:@nicknisi/pi-cloak",
    "npm:pi-clarify",
    "npm:pi-powerline-footer",
    "npm:pi-rewind",
    "npm:pi-web-access@0.35.0",
    "git:git@github.com:Launchmetrics/LM-AI@main",
    "npm:pi-subagents"
  ],
  "powerline": {
    "welcome": false,
    "cost": {
      "subscriptionDisplay": "reported-cost"
    },
    "fixedEditor": false,
    "layout": {
      "left": [
        "model",
        "thinking",
        "shell_mode",
        "path",
        "context_pct",
        "cost"
      ],
      "secondary": [
        "git"
      ]
    }
  },
  "steeringMode": "all",
  "tuiMode": "regular",
  "subagents": {
    "defaultModel": "openrouter/deepseek/deepseek-v4.1-flash-1017",
    "defaultThinking": "high"
  }
}